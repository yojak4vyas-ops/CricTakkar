rules_version = '2';

// ===== CRICTAKKAR FIRESTORE SECURITY RULES =====
//
// These matter more than usual for this app. Phase 3 multiplayer has NO
// game server (see CLAUDE.md "PHASE 3 MULTIPLAYER ARCHITECTURE") — the
// host's browser is the authority. That means these rules are the only
// thing standing between a player and a faked scoreboard.
//
// They cannot stop every kind of cheating: question-bank.js is a public
// file, so the correct answers are readable by anyone who opens the
// browser console, and the client is the one reporting isCorrect. That is
// a known, accepted limitation of the no-server design. What these rules
// DO guarantee is the structural stuff a determined cheater would
// otherwise get for free:
//   - you cannot write an answer as somebody else
//   - you cannot answer the same question twice to inflate your score
//   - you cannot change your answer after seeing the correct one
//   - you cannot rewrite the leaderboard/bracket unless you actually hold
//     hostUid (the one deliberate exception: any current player may claim
//     an abandoned hostUid for themselves — see "HOST MIGRATION" comments
//     below and CLAUDE.md — but that single-field claim still gates every
//     other host-only write behind actually holding the role afterward)
//   - you cannot read what other players answered before the reveal

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    // ===================================================================
    // USERS — profiles, XP, streaks, badges
    // ===================================================================
    // Readable by any signed-in user because the global leaderboard,
    // friends comparison and percentile rank all rank you against others.
    match /users/{userId} {
      allow read: if signedIn();
      allow create, update: if signedIn() && request.auth.uid == userId;
      allow delete: if false;

      // ===================================================================
      // PRIVATE — email, real name, FCM push token
      // ===================================================================
      // Split out from the public doc above (audit item S1): the public doc
      // is readable by any signed-in user because the leaderboard, friends
      // comparison and percentile rank all need to rank you against others
      // — but that meant your email address, real name and push token were
      // readable by anyone with a free account too. Firestore has no
      // field-level read security, so hiding these fields from other users
      // requires physically storing them somewhere else — here.
      match /private/{docId} {
        allow read, write: if signedIn() && request.auth.uid == userId;
      }
    }

    // ===================================================================
    // COMMUNITY POEMS
    // ===================================================================
    match /communityPoems/{poemId} {
      allow read: if true;
      allow create: if signedIn()
                    && request.resource.data.authorUid == request.auth.uid;

      // Anyone signed in can update, because likes / reports / commentCount
      // are all other people acting on someone else's poem. The author
      // fields are pinned so an editor cannot rewrite authorship.
      allow update: if signedIn()
                    && request.resource.data.authorUid == resource.data.authorUid
                    && request.resource.data.authorName == resource.data.authorName;

      allow delete: if signedIn() && resource.data.authorUid == request.auth.uid;

      match /comments/{commentId} {
        allow read: if true;
        allow create: if signedIn()
                      && request.resource.data.authorUid == request.auth.uid;
        allow update: if false;

        // Two people can legitimately delete a comment: whoever wrote it,
        // and the author of the poem it sits under — because deleting a
        // poem batch-deletes its comments, and those were written by other
        // people. The previously live rules granted neither, which meant
        // deleting a poem that had any comments failed silently.
        allow delete: if signedIn() && (
                        resource.data.authorUid == request.auth.uid
                        || get(/databases/$(database)/documents/communityPoems/$(poemId))
                             .data.authorUid == request.auth.uid
                      );
      }
    }

    // ===================================================================
    // MATCHES — Phase 3 multiplayer
    // ===================================================================
    match /matches/{matchId} {

      function isHost() {
        return signedIn() && resource.data.hostUid == request.auth.uid;
      }

      function isPlayer() {
        return signedIn() && request.auth.uid in resource.data.players;
      }

      // Only the players map changed, and only this player's own entry
      // inside it. This is what lets someone join or leave a room without
      // also letting them touch the score, the phase, or the host.
      function onlyChangedOwnPlayerEntry() {
        return request.resource.data.diff(resource.data)
                 .affectedKeys().hasOnly(['players'])
               && request.resource.data.players
                 .diff(resource.data.players)
                 .affectedKeys().hasOnly([request.auth.uid]);
      }

      // HOST MIGRATION (see CLAUDE.md "HOST MIGRATION & GRACEFUL LEAVING"):
      // if the recorded host's browser vanishes mid-match, another present
      // player's client can take over. Claiming the role is writing ONLY
      // this one field to your own uid — deliberately unconditional here,
      // since the rule can't itself verify "the old host actually went
      // quiet." That judgment lives entirely in the client's own staleness
      // check; this rule only guarantees a genuine current player did it,
      // not an outsider. Everything else about running the match (phase,
      // leaderboard, eliminated, status) still requires actually holding
      // hostUid via isHost() above, completely unchanged. Given this app
      // already has no money at stake and an already-self-writable-XP
      // trust model (see CLAUDE.md's Scale & Safety Audit S3), this is a
      // small extension of an already-accepted risk, not a new one.
      function onlyClaimedHost() {
        return request.resource.data.diff(resource.data)
                 .affectedKeys().hasOnly(['hostUid'])
               && request.resource.data.hostUid == request.auth.uid;
      }

      // A player may check in (presence heartbeat) or mark themselves as
      // having left, at any time while they're in the room — this is what
      // lets a match keep running instead of being killed outright the
      // moment somebody's browser closes, and what lets host migration
      // above actually detect that the old host is gone. Scoped exactly
      // like onlyChangedOwnPlayerEntry: only your own key, in only these
      // two maps.
      function touchedOnlyOwnKeyIn(fieldName) {
        return !(fieldName in request.resource.data.diff(resource.data).affectedKeys())
               || request.resource.data[fieldName]
                    .diff(resource.data.get(fieldName, {}))
                    .affectedKeys().hasOnly([request.auth.uid]);
      }
      function onlyChangedOwnPresenceOrLeft() {
        return request.resource.data.diff(resource.data)
                 .affectedKeys().hasOnly(['presence', 'leftPlayers'])
               && touchedOnlyOwnKeyIn('presence')
               && touchedOnlyOwnKeyIn('leftPlayers');
      }

      // Any signed-in user can read: you have to be able to look a room up
      // by its code before you are a member of it.
      allow read: if signedIn();

      // The document ID IS the room code, so a room is found with a direct
      // get() instead of a query — no composite index, and nobody can
      // squat a code that is already live, because create only succeeds
      // on a document that does not exist yet.
      allow create: if signedIn()
                    && request.resource.data.hostUid == request.auth.uid
                    && request.resource.data.status == 'lobby'
                    && request.resource.data.roomCode == matchId;

      // The host drives the match. Everyone else may only join/leave the
      // lobby, check in, mark themselves left, or claim an abandoned host
      // role.
      allow update: if isHost()
                    || (signedIn() && onlyChangedOwnPlayerEntry())
                    || (isPlayer() && onlyClaimedHost())
                    || (isPlayer() && onlyChangedOwnPresenceOrLeft());

      allow delete: if isHost();

      // =================================================================
      // ANSWERS — one immutable document per player, per question
      // =================================================================
      match /answers/{answerId} {

        // Only the host reads these, and only to compute the leaderboard.
        // Restricting it stops a player from watching what everyone else
        // picked before the answer is revealed and copying the crowd.
        // Costs one extra document read per aggregation query, which is
        // negligible against the daily quota.
        allow read: if signedIn()
                    && get(/databases/$(database)/documents/matches/$(matchId))
                         .data.hostUid == request.auth.uid;

        // The document ID is pinned to "{uid}_{questionIndex}". Without
        // this, a player could write many answer documents for the same
        // question under different IDs and inflate their own score, since
        // the host aggregates by questionIndex.
        allow create: if signedIn()
                      && request.resource.data.uid == request.auth.uid
                      && answerId == request.auth.uid + '_' +
                                     string(request.resource.data.questionIndex);

        // Immutable once written — this is what stops a player changing
        // their answer after the correct one is revealed.
        allow update, delete: if false;
      }
    }

    // ===================================================================
    // WORDLE MATCHES — Day 56: multiplayer Cricket Wordle
    // ===================================================================
    // Same lobby/host/presence shape as /matches above, in its own
    // collection since a Wordle round (one shared mystery player, up to 6
    // private guesses each over a shared clock) doesn't fit the quiz
    // engine's per-question phase model. See wordle-multiplayer.js.
    match /wordleMatches/{matchId} {

      function isWmHost() {
        return signedIn() && resource.data.hostUid == request.auth.uid;
      }

      function isWmPlayer() {
        return signedIn() && request.auth.uid in resource.data.players;
      }

      function onlyChangedOwnWmPlayerEntry() {
        return request.resource.data.diff(resource.data)
                 .affectedKeys().hasOnly(['players'])
               && request.resource.data.players
                 .diff(resource.data.players)
                 .affectedKeys().hasOnly([request.auth.uid]);
      }

      // HOST MIGRATION — same mechanism as /matches and /tournaments above.
      function onlyClaimedWmHost() {
        return request.resource.data.diff(resource.data)
                 .affectedKeys().hasOnly(['hostUid'])
               && request.resource.data.hostUid == request.auth.uid;
      }

      function touchedOnlyOwnWmKeyIn(fieldName) {
        return !(fieldName in request.resource.data.diff(resource.data).affectedKeys())
               || request.resource.data[fieldName]
                    .diff(resource.data.get(fieldName, {}))
                    .affectedKeys().hasOnly([request.auth.uid]);
      }
      function onlyChangedOwnWmPresenceOrLeft() {
        return request.resource.data.diff(resource.data)
                 .affectedKeys().hasOnly(['presence', 'leftPlayers'])
               && touchedOnlyOwnWmKeyIn('presence')
               && touchedOnlyOwnWmKeyIn('leftPlayers');
      }

      allow read: if signedIn();

      allow create: if signedIn()
                    && request.resource.data.hostUid == request.auth.uid
                    && request.resource.data.status == 'lobby'
                    && request.resource.data.roomCode == matchId;

      // The host starts the match and writes the final leaderboard.
      // Everyone else may only join/leave the lobby, check in, mark
      // themselves left, or claim an abandoned host role.
      allow update: if isWmHost()
                    || (signedIn() && onlyChangedOwnWmPlayerEntry())
                    || (isWmPlayer() && onlyClaimedWmHost())
                    || (isWmPlayer() && onlyChangedOwnWmPresenceOrLeft());

      allow delete: if isWmHost();

      // =================================================================
      // GUESSES — one doc per player, holding their own guess list so far.
      // Readable only by the guesser themselves and the host (who needs
      // to read everyone's to score the round) — this is what stops a
      // player seeing how far along anyone else is before the reveal.
      // =================================================================
      match /guesses/{uid} {
        allow read: if signedIn()
                    && (request.auth.uid == uid
                        || get(/databases/$(database)/documents/wordleMatches/$(matchId)).data.hostUid == request.auth.uid);
        allow write: if signedIn() && request.auth.uid == uid;
      }
    }

    // ===================================================================
    // RANKING MATCHES — Day 56: multiplayer Ranking Challenge
    // ===================================================================
    // Same lobby/host/presence shape as /matches and /wordleMatches above.
    // See ranking-multiplayer.js.
    match /rankingMatches/{matchId} {

      function isRmHost() {
        return signedIn() && resource.data.hostUid == request.auth.uid;
      }

      function isRmPlayer() {
        return signedIn() && request.auth.uid in resource.data.players;
      }

      function onlyChangedOwnRmPlayerEntry() {
        return request.resource.data.diff(resource.data)
                 .affectedKeys().hasOnly(['players'])
               && request.resource.data.players
                 .diff(resource.data.players)
                 .affectedKeys().hasOnly([request.auth.uid]);
      }

      function onlyClaimedRmHost() {
        return request.resource.data.diff(resource.data)
                 .affectedKeys().hasOnly(['hostUid'])
               && request.resource.data.hostUid == request.auth.uid;
      }

      function touchedOnlyOwnRmKeyIn(fieldName) {
        return !(fieldName in request.resource.data.diff(resource.data).affectedKeys())
               || request.resource.data[fieldName]
                    .diff(resource.data.get(fieldName, {}))
                    .affectedKeys().hasOnly([request.auth.uid]);
      }
      function onlyChangedOwnRmPresenceOrLeft() {
        return request.resource.data.diff(resource.data)
                 .affectedKeys().hasOnly(['presence', 'leftPlayers'])
               && touchedOnlyOwnRmKeyIn('presence')
               && touchedOnlyOwnRmKeyIn('leftPlayers');
      }

      allow read: if signedIn();

      allow create: if signedIn()
                    && request.resource.data.hostUid == request.auth.uid
                    && request.resource.data.status == 'lobby'
                    && request.resource.data.roomCode == matchId;

      allow update: if isRmHost()
                    || (signedIn() && onlyChangedOwnRmPlayerEntry())
                    || (isRmPlayer() && onlyClaimedRmHost())
                    || (isRmPlayer() && onlyChangedOwnRmPresenceOrLeft());

      allow delete: if isRmHost();

      // =================================================================
      // ANSWERS — one immutable document per player, per challenge round.
      // Same "{uid}_{index}" ID-pinning as /matches/answers, so a player
      // can't write duplicate answers for the same round to inflate their
      // score, and can't change their submitted order after seeing the
      // reveal. Read is host-only, same reasoning as /matches/answers:
      // stops a player copying another live player's submitted order
      // before the round ends.
      // =================================================================
      match /answers/{answerId} {
        allow read: if signedIn()
                    && get(/databases/$(database)/documents/rankingMatches/$(matchId)).data.hostUid == request.auth.uid;

        allow create: if signedIn()
                      && request.resource.data.uid == request.auth.uid
                      && answerId == request.auth.uid + '_' +
                                     string(request.resource.data.challengeIndex);

        allow update, delete: if false;
      }
    }

    // ===================================================================
    // TOURNAMENTS — Phase 3 knockout brackets
    // ===================================================================
    // Mirrors the matches rules above almost exactly: the tournament host
    // is the sole authority over round advancement and results, and
    // everyone else may only add or remove themselves from the lobby's
    // players map. A tournament never needs any special match-creation
    // permission — each bracket pairing is just a normal document in the
    // /matches collection above, created by one of its own two players
    // exactly like a manual 1v1 duel, using a deterministic ID
    // ("{tournamentCode}-R{round}-S{slot}") that both players and the
    // tournament host can independently compute without any doc ever
    // needing to hand it to them.
    match /tournaments/{tournamentId} {

      function isTournamentHost() {
        return signedIn() && resource.data.hostUid == request.auth.uid;
      }

      function isTournamentPlayer() {
        return signedIn() && request.auth.uid in resource.data.players;
      }

      function onlyChangedOwnTournamentPlayerEntry() {
        return request.resource.data.diff(resource.data)
                 .affectedKeys().hasOnly(['players'])
               && request.resource.data.players
                 .diff(resource.data.players)
                 .affectedKeys().hasOnly([request.auth.uid]);
      }

      // HOST MIGRATION — same mechanism and same reasoning as /matches
      // above (see that block's comments, and CLAUDE.md "HOST MIGRATION &
      // GRACEFUL LEAVING"): if the organiser's browser vanishes mid-
      // tournament, another present player can claim the role by writing
      // ONLY this field, unconditionally as far as this rule is concerned.
      function onlyClaimedTournamentHost() {
        return request.resource.data.diff(resource.data)
                 .affectedKeys().hasOnly(['hostUid'])
               && request.resource.data.hostUid == request.auth.uid;
      }

      function touchedOnlyOwnTournamentKeyIn(fieldName) {
        return !(fieldName in request.resource.data.diff(resource.data).affectedKeys())
               || request.resource.data[fieldName]
                    .diff(resource.data.get(fieldName, {}))
                    .affectedKeys().hasOnly([request.auth.uid]);
      }
      function onlyChangedOwnTournamentPresenceOrLeft() {
        return request.resource.data.diff(resource.data)
                 .affectedKeys().hasOnly(['presence', 'leftPlayers'])
               && touchedOnlyOwnTournamentKeyIn('presence')
               && touchedOnlyOwnTournamentKeyIn('leftPlayers');
      }

      allow read: if signedIn();

      allow create: if signedIn()
                    && request.resource.data.hostUid == request.auth.uid
                    && request.resource.data.status == 'lobby'
                    && request.resource.data.tournamentCode == tournamentId;

      // The host drives round advancement and writes results. Everyone
      // else may only join/leave the lobby, check in, mark themselves
      // left, or claim an abandoned host role.
      allow update: if isTournamentHost()
                    || (signedIn() && onlyChangedOwnTournamentPlayerEntry())
                    || (isTournamentPlayer() && onlyClaimedTournamentHost())
                    || (isTournamentPlayer() && onlyChangedOwnTournamentPresenceOrLeft());

      allow delete: if isTournamentHost();
    }

    // ===================================================================
    // SCHEDULED SIGNUPS — Day 47: the host-less 8pm Knockout / 10pm League
    // (see CLAUDE.md "HOST-LESS SCHEDULED TOURNAMENTS"). This is only ever
    // an open, no-cap sign-up sheet — the real bracket lives in /tournaments
    // above once the scheduled bot builds it. There is no client-side path
    // for locking, cancelling, or building the bracket: only the bot (using
    // the Admin SDK, which bypasses these rules entirely) can do that, so
    // "status" only ever moves from 'open' via a server credential nothing
    // here needs to authorize.
    // ===================================================================
    match /scheduledSignups/{eventId} {

      function onlyChangedOwnSignupEntry() {
        return request.resource.data.diff(resource.data)
                 .affectedKeys().hasOnly(['players'])
               && request.resource.data.players
                 .diff(resource.data.players)
                 .affectedKeys().hasOnly([request.auth.uid]);
      }

      allow read: if signedIn();

      // Whoever is first to try to join today's event creates its sign-up
      // sheet, already containing themselves — same collision-check pattern
      // tournament.js's own createTournament() already uses. Pinned to a
      // fresh, just-opened shape so a client can't create a doc that's
      // already "started" or already has someone else's tournamentCode.
      allow create: if signedIn()
                    && request.resource.data.eventId == eventId
                    && request.resource.data.type in ['knockout', 'league']
                    && request.resource.data.status == 'open'
                    && request.resource.data.tournamentCode == null
                    && request.resource.data.players.size() == 1
                    && request.resource.data.players.keys().hasOnly([request.auth.uid]);

      // Players may only add or remove their OWN entry, and only while
      // sign-ups are still open. Locking, cancelling, and writing the real
      // tournamentCode all happen after this — bot-only, no rule for it.
      allow update: if signedIn() && resource.data.status == 'open'
                    && onlyChangedOwnSignupEntry();

      allow delete: if false;
    }

    // Anything not named above is denied by default.
  }
}
